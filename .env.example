# Copie estas variaveis para o Coolify (Environment Variables). Nunca coloque as chaves em arquivo no repositorio.
MODO=observacao                 # observacao = precos publicos, sem ordem | teste = testnet | real = Binance
BINANCE_API_KEY=                # chave da conta de TESTE enquanto MODO=teste
BINANCE_API_SECRET=
CAPITAL_MAX=0                   # 0 = opera tudo que ha na conta; ex. 5000 = limita a 5.000 USDT
SIMBOLOS=BTCUSDT,ETHUSDT,BNBUSDT,XRPUSDT,ADAUSDT,SOLUSDT,DOGEUSDT,LINKUSDT,LTCUSDT,AVAXUSDT,DOTUSDT,TRXUSDT
SINAL=raghee                    # raghee (onda 34 EMA + relogio) | donchian
ANG_MIN=0.17                    # angulo minimo do relogio (0,15-0,20 testado)
N=55                            # so para SINAL=donchian
SAIDA=20
FILTRO_BTC=150
VOL_ALVO=0.35
BANDA=0.10
HORA_UTC=0
MINUTO_UTC=5
SENHA_PAINEL=                   # senha do painel web (usuario: qualquer)
BACKUP_REPOSITORIO=Ismael457070/robo-trader-arquivo
BACKUP_RAMO=arquivo
BACKUP_GITHUB_TOKEN=            # token fino, so Contents no repositorio PRIVADO; nunca commitar
